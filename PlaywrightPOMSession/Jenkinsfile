pipeline {
    agent any

    tools {
        maven 'Maven-3'
    }

    environment {
        SMOKE_PASSED = '0'; SMOKE_FAILED = '0'; SMOKE_SKIPPED = '0';
        REG_PASSED = '0'; REG_FAILED = '0'; REG_SKIPPED = '0';
        STATUS_COLOR = "#28a745"
    }

    stages {

        stage('Smoke Test') {
            steps {
            dir('smoke-repo') {
                git 'https://github.com/jglick/simple-maven-project-with-tests.git'
                bat "mvn -Dmaven.test.failure.ignore=true clean package"
            }
          }
            post {
                always {                 
					script {
						 def smoke = junit (
					testResults: 'smoke-repo/target/surefire-reports/TEST-*.xml',
					allowEmptyResults: true
					)
                            env.SMOKE_PASSED = smoke.passCount.toString()
                            env.SMOKE_FAILED = smoke.failCount.toString()
                            env.SMOKE_SKIPPED = smoke.skipCount.toString()               
					}
                }	
            }
        }

        stage('Build Validation') {
            steps {
                echo "validation stage before QA deploy"
            }
        }

        stage('Deploy to QA') {
            steps {
                echo "Deploying to QA environment"
            }
        }

        stage('Regression Test') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                dir('playwright-repo') {
                    git 'https://github.com/ragav002-rs/PlaywrightCode'
                    bat "mvn -f PlaywrightPOMSession clean test -Dsurefire.suiteXmlFiles=src/test/resources/TestRunners/testng.xml"
                }
            }
        } 
    }   
        	post {
				always {				
					script {
						def reg = junit (
				testResults: 'playwright-repo/target/surefire-reports/*.xml',
				allowEmptyResults: true				
					)					
                            env.REG_PASSED = reg.passCount.toString()
                            env.REG_FAILED = reg.failCount.toString()
                            env.REG_SKIPPED = reg.skipCount.toString()
                        }
					}
				}  
			}

	post {
        success {
            script { env.STATUS_COLOR = "#28a745" }
        }
        unstable {
            script { env.STATUS_COLOR = "#fb6f00" }
        }
        failure {
            script { env.STATUS_COLOR = "#ff0033" }
        }
        
        always {
            emailext(
                subject: "Pipeline ${currentBuild.currentResult}: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                mimeType: 'text/html',
                to: 'ragav002@gmail.com',
                body: """
                <html>
                <body style="font-family: Arial; padding: 20px;">
                    <div style="background: ${env.STATUS_COLOR}; color: white; padding: 15px; border-radius: 5px 5px 0 0;">
                        <h2 style="margin: 0;">Execution Summary</h2>
                    </div>
                    <div style="border: 1px solid #ddd; padding: 20px;">
                        <h3>Test Breakdown</h3>
                        <table border="1" cellpadding="10" style="border-collapse: collapse; width: 100%;">
                            <tr style="background: #f2f2f2;">
                                <th>Test Suite</th>
                                <th>Passed</th>
                                <th>Failed</th>
                                <th>Skipped</th>
                            </tr>
                            <tr>
                                <td><b>Smoke Tests</b></td>
                                <td style="color: green;">${env.SMOKE_PASSED}</td>
                                <td style="color: red;">${env.SMOKE_FAILED}</td>
                                <td style="color: gray;">${env.SMOKE_SKIPPED}</td>
                            </tr>
                            <tr>
                                <td><b>Regression Tests</b></td>
                                <td style="color: green;">${env.REG_PASSED}</td>
                                <td style="color: red;">${env.REG_FAILED}</td>
                                <td style="color: gray;">${env.REG_SKIPPED}</td>
                            </tr>
                        </table>
                        <br/>
                        <a href="${env.BUILD_URL}testReport" style="background: #28a745; color: white; padding: 10px; text-decoration: none; border-radius: 4px;">Detailed Test Report</a>
                    </div>
                </body>
                </html>
                """
            )
        }
    }
}