pipeline {
    agent any

    tools {
        maven 'Maven-3'
    }

    environment {
        SMOKE_PASSED = '0' SMOKE_FAILED = '0' SMOKE_SKIPPED = '0'
        REG_PASSED = '0' REG_FAILED = '0' REG_SKIPPED = '0'
        STATUS_COLOR = "#28a745"
    }

    stages {

        stage('Smoke Test') {
            steps {
            dir('smoke-repo') {
                git 'https://github.com/jglick/simple-maven-project-with-tests.git'
                bat "mvn -Dmaven.test.failure.ignore=true clean package"
            }
          }
            post {
                always {                 
					script {
    				def	smokeResults = junit(
       					testResults: 'smoke-repo/target/surefire-reports/TEST-*.xml',
        				allowEmptyResults: false
   					 )

    					env.SMOKE_PASSED  = smokeResults.passCount.toString()
						env.SMOKE_FAILED  = smokeResults.failCount.toString()
						env.SMOKE_SKIPPED = smokeResults.skipCount.toString()
						
						echo "Smoke → Passed=${env.SMOKE_PASSED}, Failed=${env.SMOKE_FAILED}, Skipped=${env.SMOKE_SKIPPED}"
					}
                }	
            }
		}

        stage('Build Validation') {
            steps {
                echo "validation stage before QA deploy"
            }
        }

        stage('Deploy to QA') {
            steps {
                echo "Deploying to QA environment"
            }
        }

        stage('Regression Test') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                dir('playwright-repo') {
                    git 'https://github.com/ragav002-rs/PlaywrightCode'
                    bat "mvn -f PlaywrightPOMSession clean test -Dsurefire.suiteXmlFiles=src/test/resources/TestRunners/testng.xml"
                }
            }
        }  
        	post {
				always {				
					script {
    				def	regressionResults = junit(
        				testResults: 'playwright-repo/PlaywrightPOMSession/target/surefire-reports/*.xml',
        				allowEmptyResults: false
    				)

    					env.REG_PASSED  = regressionResults.passCount.toString()
						env.REG_FAILED  = regressionResults.failCount.toString()
						env.REG_SKIPPED = regressionResults.skipCount.toString()
							
						echo "Regression → Passed=${env.REG_PASSED}, Failed=${env.REG_FAILED}, Skipped=${env.REG_SKIPPED}"
					}
				}
			}  
		}
	}			
	post {
        success {
            script { env.STATUS_COLOR = "#28a745" }
        }
        unstable {
            script { env.STATUS_COLOR = "#fb6f00" }
        }
        failure {
            script { env.STATUS_COLOR = "#ff0033" }
        }
        
        always {
            emailext(
                subject: "Pipeline ${currentBuild.currentResult}: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                mimeType: 'text/html',
                to: 'ragav002@gmail.com',
                body: """
					<html>
					<body style="font-family: Arial; padding: 20px; background:#f5f5f5;">
					
					<!-- HEADER -->
					<div style="background: ${env.STATUS_COLOR}; color: white; padding: 15px; border-radius: 6px;">
					    <h2 style="margin:0;">Pipeline ${currentBuild.currentResult}: ${env.JOB_NAME} #${env.BUILD_NUMBER}</h2>
					</div>
					
					<br/>
					
					<!-- BOX 1 : PIPELINE SUMMARY -->
					<div style="background:white; border:1px solid #ddd; padding:20px; border-radius:6px;">
					    <h3 style="margin-top:0;">Pipeline Summary</h3>
					
					    <table cellpadding="10" style="width:100%; border-collapse: collapse;">
					        <tr>
					            <td><b>Overall Status</b></td>
					            <td style="color:${env.STATUS_COLOR}; font-weight:bold;">
					                ${currentBuild.currentResult}
					            </td>
					        </tr>
					        <tr>
					            <td><b>Job Name</b></td>
					            <td>${env.JOB_NAME}</td>
					        </tr>
					        <tr>
					            <td><b>Build Number</b></td>
					            <td>#${env.BUILD_NUMBER}</td>
					        </tr>
					    </table>
					
					    <br/>
					    <a href="${env.BUILD_URL}console"
					       style="background:#007bff; color:white; padding:10px 15px;
					              text-decoration:none; border-radius:4px; display:inline-block;">
					        View Console Output
					    </a>
					</div>
					
					<br/>
					
					<!-- BOX 2 : TEST EXECUTION SUMMARY -->
					<div style="background:white; border:1px solid #ddd; padding:20px; border-radius:6px;">
					    <h3 style="margin-top:0;">Test Execution Summary</h3>
					
					    <table border="1" cellpadding="10"
					           style="border-collapse: collapse; width:100%;">
					        <tr style="background:#f2f2f2;">
					            <th>Test Suite</th>
					            <th>Passed</th>
					            <th>Failed</th>
					            <th>Skipped</th>
					        </tr>
					        <tr>
					            <td><b>Smoke Tests</b></td>
					            <td style="color:green;">${env.SMOKE_PASSED}</td>
					            <td style="color:red;">${env.SMOKE_FAILED}</td>
					            <td style="color:gray;">${env.SMOKE_SKIPPED}</td>
					        </tr>
					        <tr>
					            <td><b>Regression Tests</b></td>
					            <td style="color:green;">${env.REG_PASSED}</td>
					            <td style="color:red;">${env.REG_FAILED}</td>
					            <td style="color:gray;">${env.REG_SKIPPED}</td>
					        </tr>
					    </table>
					
					    <br/>
					    <a href="${env.BUILD_URL}testReport"
					       style="background:#28a745; color:white; padding:10px 15px;
					              text-decoration:none; border-radius:4px; display:inline-block;">
					        View Test Results
					    </a>
					</div>
					
					</body>
					</html>
					"""

            )
        }
    }
}