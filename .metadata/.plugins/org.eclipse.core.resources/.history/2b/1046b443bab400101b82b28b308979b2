package playwrightsessions;

import java.nio.file.Paths;

import com.microsoft.playwright.Browser;
import com.microsoft.playwright.BrowserContext;
import com.microsoft.playwright.BrowserType;
import com.microsoft.playwright.Page;
import com.microsoft.playwright.Playwright;

public class LoginLaunch {

	
	
	public static void main (String [] args) {
		
		Playwright playwright = Playwright.create();
		Browser browser = playwright.firefox().launch(new BrowserType.LaunchOptions().setHeadless(false));
		
		String absolutePath = "home/ragavkumar/eclipse-workspace/PlaywrightSessions/PlaywrightSessions/resources/Amazonlogin.json";
		BrowserContext browsercontext = browser.newContext(new Browser.NewContextOptions().setStorageStatePath(Paths.get(absolutePath)));
		
	
		Page page = browsercontext.newPage();
		page.navigate("https://www.amazon.in/");
		
		
		
		
	}
}
