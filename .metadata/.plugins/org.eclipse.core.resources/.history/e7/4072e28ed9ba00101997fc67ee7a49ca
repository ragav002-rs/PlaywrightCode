<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>PlaywrightPOMSession</groupId>
  <artifactId>PlaywrightPOMSession</artifactId>
  <version>0.0.1-SNAPSHOT</version>

  <name>PlaywrightPOMSession</name>
  <url>http://www.example.com</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Setting the Java compiler level to 17 as per your initial setup -->
    <maven.compiler.release>17</maven.compiler.release>
    
    <!-- Centralized Versions for easy updating -->
    <playwright.version>1.54.0</playwright.version>
    <testng.version>7.10.2</testng.version>
    <surefire.version>3.3.0</surefire.version>
  </properties>

  <dependencies>
    
    <!-- 1. Playwright Dependency: Core library for browser automation -->
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>1.56.0</version>
    </dependency>

    <!-- 2. TestNG Dependency: Testing framework library (contains @Test, @BeforeMethod, etc.) -->
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>7.11.0</version>
      <scope>test</scope>
    </dependency>
    
    <!-- NOTE: Removed conflicting JUnit dependencies from your original file -->

  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <!-- The maven-surefire-plugin runs the tests (TestNG in this case) -->
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.2</artifactId>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.1.2</artifactId>
        </plugin>
        <plugin>
          <artifactId>maven-site-plugin</artifactId>
          <version>3.12.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-project-info-reports-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>