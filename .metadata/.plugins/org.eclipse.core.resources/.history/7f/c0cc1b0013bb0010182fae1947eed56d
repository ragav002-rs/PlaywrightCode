package com.qa.zepto.pages;

import com.microsoft.playwright.Page;

public class HomePage {

	Page page;
	
	private String searchclick =".w20 h20 c3 dIb vM";
	private String search = "#srcInpu";
	private String searchicon = ".dIb c8 h24 w24 pA t8 l12";
	private String searchtitle = "//span[text()='shirt']";
	
	
	public HomePage(Page page) {
		this.page = page;		
	}
	
	public String HomepageTitle() {
		String title = page.title();
		System.out.println("Title:" + title);
		return title;
	}
	
	public String HomepageUrl() {
		String url = page.url();
		System.out.println("URL:" + url);
		return url;
		
	}
	
	public String SearchOption(String productname) {
		page.click(searchclick);
		page.fill(search, productname);
		page.click(searchicon);
		String searchheader = page.textContent(searchtitle);
		System.out.println("SearchTitle:" + searchheader);
		return searchheader;
	}

}
