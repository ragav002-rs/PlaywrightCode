pipeline 
{
    agent any
    
    tools{
    	maven 'maven'
        }

    stages 
    {
        stage('Build') 
        {
            steps
            {
                 git 'https://github.com/jglick/simple-maven-project-with-tests.git'
                 sh "mvn -Dmaven.test.failure.ignore=true clean package"
            }
            post 
            {
                success
                {
                    junit '**/target/surefire-reports/TEST-*.xml'
                    archiveArtifacts 'target/*.jar'
                }
            }
        }
        
        
        
        stage("Deploy to QA"){
            steps{
                echo("deploy to qa")
            }
        }
                
        stage('Regression Automation Test') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    git 'https://github.com/naveenanimation20/Playwright-Java-PageObjectModel'
                    sh "mvn clean test -Dsurefire.suiteXmlFiles=src/test/resources/testrunners/testng_regressions.xml"
                    
                }
            }
        
        
        post {
                // 'always' ensures this runs whether the tests passed or failed, 
                // so you always get the report.
                always {
                    echo 'Publishing TestNG reports for Playwright suite...'
                    
                    // The 'testng' step processes the XML file generated by Maven Surefire/Failsafe.
                    // The path is relative to the Jenkins workspace root, pointing into the checkout directory.
                    testng reports: 'playwright-test-suite/target/surefire-reports/testng-results.xml', 
                           unstableThreshold: 0
                    
                    // Optional: Archive the TestNG HTML report for detailed viewing in the Jenkins UI
                    archiveArtifacts artifacts: 'playwright-test-suite/target/surefire-reports/html/**'
                }
            }
    
        }
      
      }       
        
    }
